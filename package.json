{
  "name": "@enbox/crdt",
  "version": "0.1.1",
  "description": "Collaborative documents, durable sync planning, realtime healing, and editor persistence adapters for Enbox applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./yjs1": {
      "types": "./dist/yjs1/index.d.ts",
      "import": "./dist/yjs1/index.js"
    },
    "./yjs1/advanced": {
      "types": "./dist/yjs1/advanced.d.ts",
      "import": "./dist/yjs1/advanced.js"
    },
    "./yjs1/awareness": {
      "types": "./dist/yjs1/awareness.d.ts",
      "import": "./dist/yjs1/awareness.js"
    },
    "./yjs1/codemirror": {
      "types": "./dist/yjs1/codemirror.d.ts",
      "import": "./dist/yjs1/codemirror.js"
    },
    "./yjs1/indexeddb": {
      "types": "./dist/yjs1/indexeddb.d.ts",
      "import": "./dist/yjs1/indexeddb.js"
    },
    "./enbox": {
      "types": "./dist/enbox/index.d.ts",
      "import": "./dist/enbox/index.js"
    },
    "./live": {
      "types": "./dist/live/index.d.ts",
      "import": "./dist/live/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures",
    "SPEC.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "bun scripts/generate-fixtures.ts",
    "prepublishOnly": "bun run build",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "bun run build && changeset publish"
  },
  "homepage": "https://github.com/enboxorg/enbox-crdt#readme",
  "bugs": "https://github.com/enboxorg/enbox-crdt/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enboxorg/enbox-crdt.git"
  },
  "license": "Apache-2.0",
  "contributors": [
    {
      "name": "Liran Cohen",
      "url": "https://github.com/LiranCohen"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "y-codemirror.next": "0.3.5",
    "y-indexeddb": "9.0.12",
    "y-protocols": "1.0.7",
    "yjs": "13.6.31"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.0",
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.8",
    "@types/node": "20.19.33",
    "fake-indexeddb": "6.2.4",
    "jsdom": "25.0.1",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "crdt",
    "yjs",
    "enbox",
    "dwn",
    "local-first",
    "e2ee",
    "sync"
  ]
}
